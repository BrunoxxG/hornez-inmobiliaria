// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)

  properties Property[] @relation("PropertyCreators")
  approvedProperties Property[] @relation("PropertyApprovals")
  drafts Draft[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("users")
}

model ListingType {
  id   String @id @default(cuid())
  name String
  slug String @unique

  properties Property[]

  @@map("listing_types")
}

model PropertyType {
  id   String @id @default(cuid())
  name String
  slug String @unique

  properties Property[]

  @@map("property_types")
}

model Locality {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("localities")
}

enum Currency {
  USD
  ARS
}

enum PropertyStatus {
  AVAILABLE @map("Disponible")
  RESERVED  @map("Reservado")
  SOLD      @map("Vendido")
  RENTED    @map("Alquilado")
}

enum PropertyDocumentation {
  POSSESSORY_RIGHTS @map("Derechos posesorios")
  DEED              @map("Escritura")
}

enum FeatureCategory {
  SERVICE
  ADDITIONAL
}

enum ContactReason {
  TASACION
  COMPRA
  VENTA
  OTRO
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  reason    ContactReason
  message   String
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([read])
  @@index([createdAt])
  @@map("contact_inquiries")
}

model Property {
  id          String  @id @default(cuid())
  title       String
  description String
  price       Decimal @db.Decimal(12, 2)

  listingTypeId String
  listingType   ListingType @relation(fields: [listingTypeId], references: [id])

  propertyTypeId String
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id])

  address  String
  city     String
  province String

  totalRooms Int
  bedrooms   Int
  bathrooms  Int
  area       Float
  coveredArea Float @default(0)
  landArea Float @default(0)
  age Int @default(0)
  floors Int @default(0)

  currency Currency @default(USD)

  lat Float
  lng Float

  status        PropertyStatus        @default(AVAILABLE)
  documentation PropertyDocumentation @default(DEED)
  active        Boolean               @default(true)
  standOut      Boolean               @default(false)

  userId String
  user   User   @relation("PropertyCreators", fields: [userId], references: [id])

  approvalStatus ApprovalStatus @default(PENDING)
  approvedById String?
  approvedBy User? @relation("PropertyApprovals", fields: [approvedById], references: [id])
  approvedAt DateTime?
  rejectionReason String?

  images    Image[]
  documents Document[]
  video     String     @default("-")

  features PropertyFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([price])
  @@index([listingTypeId])
  @@index([propertyTypeId])
  @@index([bedrooms])
  @@index([bathrooms])
  @@index([status])
  @@index([approvalStatus])
  @@map("properties")
}

model Draft {
  id        String   @id @default(cuid())
  title     String   @default("Sin título")
  data      Json
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@map("property_drafts")
}

model Feature {
  id       String          @id @default(cuid())
  name     String
  slug     String          @unique
  category FeatureCategory @default(SERVICE)

  properties PropertyFeature[]

  @@map("features")
}

model PropertyFeature {
  id    String @id @default(cuid())
  value String @default("-")

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  featureId String
  feature   Feature @relation(fields: [featureId], references: [id])

  @@unique([propertyId, featureId])
  @@map("property_features")
}

model Image {
  id    String @id @default(cuid())
  url   String
  order Int?   @default(0)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, order])
  @@map("property_images")
}

model Document {
  id   String @id @default(cuid())
  url  String
  name String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
